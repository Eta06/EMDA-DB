[Unit]
Description=EMDA-DB project %i
After=network.target

[Service]
Type=notify
NotifyAccess=main
DynamicUser=yes
User=emda-%i
StateDirectory=emda-%i
StateDirectoryMode=0700
UMask=0077
WorkingDirectory=%S/emda-%i
LoadCredential=server.json:/etc/emda/projects/%i/server.json
LoadCredential=tls-cert.pem:/etc/emda/projects/%i/tls-cert.pem
LoadCredential=tls-key.pem:/etc/emda/projects/%i/tls-key.pem
BindReadOnlyPaths=-/etc/emda/projects/%i/live:/run/emda-live
ExecStartPre=/usr/bin/mkdir -p -m 0700 -- ${STATE_DIRECTORY}/stores
ExecStart=/usr/local/bin/emda-server --single-project ${CREDENTIALS_DIRECTORY}/server.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=90s

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectProc=invisible
ProtectClock=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

CPUQuota=100%
MemoryHigh=384M
MemoryMax=512M
TasksMax=48
LimitNOFILE=512

[Install]
WantedBy=multi-user.target
